# ---------------------------------------------------------------------------
# Rashidi Import & Export — API configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Public origin of this API — used to build image URLs for the local driver.
PUBLIC_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rashidi?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-please-replace-in-production-0123456789abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-in-production-abcdef0123456789
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- File storage -----------------------------------------------------------
# `local` writes to ./uploads and serves it from this API (single server).
# `s3`    targets any S3-compatible bucket (AWS S3, Cloudflare R2, DO Spaces, MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Required for R2 / MinIO, leave false for AWS S3
S3_FORCE_PATH_STYLE=false
# Optional CDN or custom domain in front of the bucket
S3_CDN_URL=

# --- Image processing -------------------------------------------------------
MAX_FILE_SIZE_MB=12
MAX_FILES_PER_REQUEST=12
IMAGE_FULL_WIDTH=1920
IMAGE_THUMB_WIDTH=640
IMAGE_QUALITY=82

# --- Contact form email (optional) ------------------------------------------
# When disabled, enquiries are still saved and visible in the dashboard inbox.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rashidi Website <no-reply@rashidi-ie.com>"
MAIL_TO=sales@rashidi-ie.com

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_LOGIN_MAX=10

# --- Seed account -----------------------------------------------------------
# Used once by `npm run db:seed`. Change the password after first sign-in.
ADMIN_EMAIL=rashidi@admin.com
ADMIN_PASSWORD=0122221724
ADMIN_NAME=Rashidi Administrator
